DATABASE_URL=local.db

EMAIL_FROM=user@example.com
EMAIL_FROM_NAME=Example.com

# BetterAuth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_random_secret_here

# Authentik SSO (BetterAuth)
AUTHENTIK_CLIENT_ID=your_authentik_client_id
AUTHENTIK_CLIENT_SECRET=your_authentik_client_secret
AUTHENTIK_ISSUER_URL=https://authentik.example.com/application/o/ecohubsos
AUTHENTIK_INVITATION_BOT_API_TOKEN=your_authentik_bot_api_token

# Public App URL (for OAuth callbacks and CORS)
# Must be set to your actual domain in production (e.g., https://os.ecohubs.community)
VITE_PUBLIC_APP_URL=http://localhost:5173

# Real client IP behind a reverse proxy — used to key rate limits.
# All three have working defaults (see src/lib/server/client-ip.ts); set them
# only to override.
#
# Forwarding headers are believed ONLY when the request reaches us from a proxy
# we trust — by default one connecting from loopback or a private range, which
# is where a proxy on the same host or container network sits. Callers arriving
# from anywhere else are keyed on the address they connected from, so a forged
# x-forwarded-for cannot buy a fresh rate-limit bucket. This is the trusted-proxy
# requirement: the app must not be reachable except through the proxy, or the
# proxy must be listed below.
#
# Do NOT set adapter-node's own ADDRESS_HEADER / XFF_DEPTH. This replaces them,
# and setting them makes getClientAddress() return a header-derived value — the
# very thing the trusted-peer check reads, so a caller could forge their way
# into being trusted.
#
# CLIENT_IP_PROXY_DEPTH is the number of trusted proxies in front of the app,
# counted from the right of the chain — setting it higher than the number you
# actually run lets callers pick their own bucket.
# CLIENT_IP_HEADER=x-forwarded-for
# CLIENT_IP_PROXY_DEPTH=1
# TRUSTED_PROXY_IPS=  # comma-separated, for a proxy on a public address

# Safe Global (Multi-sig Wallet)
SAFE_ADDRESS=0x...
SAFE_CHAIN_ID=1
# This is split into two keys because of length limits in some environments
SAFE_API_KEY_1=your-safe-api-key-1
SAFE_API_KEY_2=your-safe-api-key-2

# RPC URL for Safe Protocol Kit (recommended; required for non-mainnet)
SAFE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key
# OR: 
ALCHEMY_API_KEY=your-alchemy-key

# Safe Proposer (dedicated wallet for proposing new owners)
# This wallet must already be a Safe owner to propose transactions
SAFE_PROPOSER_PRIVATE_KEY=your_proposer_wallet_private_key

# Safe Onboarding Role (owner|proposer)
SAFE_ONBOARDING_ROLE=owner|proposer

# Alchemy API (for Safe Protocol Kit)
ALCHEMY_API_KEY=your_alchemy_api_key

# Discord OAuth2 Credentials
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
# Channel ID for automated news/notifications (right-click channel -> Copy ID)
DISCORD_NEWS_CHANNEL_ID=your_discord_news_channel_id

# Membership Applications API
APPLICATIONS_API_KEY=your-secure-api-key-for-external-submissions

# Public Members API
MEMBERS_API_KEY=your-secure-api-key-for-website

# Logging
LOG_FILE=logs/ecohubsOS.log

# Flarum Integration
FLARUM_API_URL=https://myflarum.example.com/api
FLARUM_API_KEY=your_flarum_api_key

# Puckstack Integration (for generating workspace invitations)
PUCKSTACK_API_URL=https://puckstack.xyz/api
PUCKSTACK_API_KEY=your_puckstack_api_key
# UUID of our Puckstack workspace (workspaces.id, NOT the "ecohubs" slug).
# Offcoin members are scoped per workspace as puckstack:{workspaceId}:{userId};
# without this we fall back to the legacy unscoped alias, which only resolves
# for members whose first Puckstack workspace was ours.
PUCKSTACK_WORKSPACE_ID=your_puckstack_workspace_uuid

# Offcoin (reputation / rewards). Credentials come from the Offcoin workspace
# settings and determine which workspace the SDK acts as.
OFFCOIN_CLIENT_ID=your_offcoin_client_id
OFFCOIN_CLIENT_SECRET=your_offcoin_client_secret
# Signing secret for POST /api/offcoin/webhook (starts with "whsec_"). Without
# it the endpoint rejects every delivery, so level-ups stop promoting members.
OFFCOIN_WEBHOOK_SECRET=whsec_your_offcoin_webhook_secret

# Listmonk Newsletter
LISTMONK_API_URL=https://newsletter.ecohubs.community/api
LISTMONK_API_USER=admin
LISTMONK_API_KEY=your_listmonk_api_key
LISTMONK_MEMBER_LIST_ID=3
